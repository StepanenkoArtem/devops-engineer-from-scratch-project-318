server:
  http_listen_address: {{ private_address }}
  http_listen_port: {{ promtail_port }}
  log_level: info

positions:
  filename: {{ promtail_positions_path }}

clients:
  - url: {{ promtail_loki_push_url }}

scrape_configs:
  - job_name: nginx-access
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx-access
          node: {{ inventory_hostname }}
          __path__: /var/log/nginx/access.log

    pipeline_stages:
      - json:
          expressions:
            status: status
            time_local: time_local
      - labels:
          status:
      - timestamp:
          source: time_local
          format: 02/Jan/2006:15:04:05 -0700

  - job_name: nginx-error
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx-error
          node: {{ inventory_hostname }}
          __path__: /var/log/nginx/error.log

    pipeline_stages:
      - regex:
          expression: '^(?P<time>\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2}) \[(?P<level>[a-z]+)\] \d+#\d+:'
      - labels:
          level:
      - timestamp:
          source: time
          format: 2006/01/02 15:04:05
          location: UTC

  - job_name: application
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 10s
        filters:
          - name: name
            values: ["{{ promtail_docker_container }}"]

    relabel_configs:
      - source_labels: ['__meta_docker_container_log_stream']
        target_label: log_stream
      - target_label: job
        replacement: application
      - target_label: node
        replacement: {{ inventory_hostname }}
      - target_label: environment
        replacement: prod

    pipeline_stages:
      - match:
          selector: '{log_stream="stdout"}'
          stages:
            - json:
                expressions:
                  level: level
            - labels:
                level:

      - match:
          selector: '{log_stream="stderr"}'
          stages:
            - regex:
                expression: '\|-(?P<level>[A-Z]+) in '
            - template:
                source: level
                template: '{% raw %}{{ if .Value }}{{ .Value }}{{ else }}unknown{{ end }}{% endraw %}'
            - labels:
                level:
