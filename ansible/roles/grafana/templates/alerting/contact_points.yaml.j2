apiVersion: 1
contactPoints:
  - orgId: 1
    name: Telegram
    receivers:
      - uid: ffu64g7vhbfgge
        type: telegram
        settings:
          bottoken: "{{ tg_bot_token }}"
          chatid: "{{ tg_chat_id }}"
          disable_notification: false
          disable_web_page_preview: false
          message: '{% raw %}{{ template "telegram.message" . }}{% endraw %}'
          parse_mode: HTML
          protect_content: false
        disableResolveMessage: false
